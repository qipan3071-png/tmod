Configs: {
	WastelandConfig: {
		DisplayName: Wasteland Soul - Settings
		ScavengerInvasionEnabled.Label: Scavenger invasion
		InvasionCycleDays.Label: Invasion cycle (in days)
		InvasionWarning.Label: Show invasion warning

		NoLootOnSelfDestruct: {
			Label: No loot after overload self-destruct
			Tooltip: If the Scavenger reaches its overload charge and tears itself apart, it drops nothing and does not advance the story
		}
	}
}

BossChecklist: {
	Scavenger.SpawnInfo: Every 5 days (warning at 19:30, arrival at 20:30), or lure it with the Scavenger Signal Sensor (5 Salvaged Steel Bars + 10 Bones). Tuned for after Skeletron and before the Wall of Flesh
	Archivist.SpawnInfo: Craft an Archivist Echo at a Demon/Crimson Altar (8 Archivist Fragments + 5 Bones + 3 Souls of Light + 6 Crystal Shards) and use it to call the audit unit down. Tuned for hardmode, on the mechanical bosses' level
	AshHeart.SpawnInfo: Craft an Ash Heart Ember at a Demon/Crimson Altar (10 Ash Heart Fragments + 3 Ectoplasm + 5 Beetle Husks) and use it after Golem
	FireplaceGuardian.SpawnInfo: Craft a Fireplace Access Key at a Demon/Crimson Altar (12 Fireplace Fragments + 4 Fireplace Alloy Bars + 6 Solar Fragments). It waits inside the Fireplace - the last original boss before the Moon Lord
}

NPCs: {
	MechanicalCompanion: {
		DisplayName: Machina

		TownNPCMood: {
			Content: My data stream is stable.
			NoHome: I have nowhere to keep this body.
			FarFromHome: We are too far from the Fireplace.
			LoveSpace: I like the emptiness - nothing gets misjudged as pollution.
			DislikeCrowded: It is a little crowded. My sensors are squeezed.
			HateCrowded: Too loud. My program is close to throwing errors.
			LikeBiome: The parameters here are agreeable - {BiomeName}.
			DislikeBiome: "{BiomeName} reminds me of contaminated ground."
			HateBiome: I hate {BiomeName}. My data corrupts here.
			LoveNPC: My core frequency steadies around {NPCName}.
			LikeNPC: "{NPCName} is acceptable."
			DislikeNPC: "{NPCName} generates too much noise."
			HateNPC: I hate {NPCName}. Their presence overloads my sensors.
			LikeNPC_Princess: "{NPCName} is lovely."
			Princess_LovesNPC: "{NPCName} is lovely."
		}

		Census.SpawnCondition: Conditions unknown
	}

