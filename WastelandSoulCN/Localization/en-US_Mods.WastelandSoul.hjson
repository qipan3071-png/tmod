Items: {
	SoulFragmentScavenger: {
		DisplayName: Soul Fragment I
		Tooltip: Quest item - code pulled from Execution Unit-07. Hand it to Machina and she updates her own memory. The Fireplace terminal holds the matching record. Only one exists per world.
	}

	SoulFragmentSecond: {
		DisplayName: Soul Fragment II
		Tooltip: Quest item - an archived log the audit unit was carrying. Hand it to Machina and she updates her own memory. Only one exists per world.
	}

	SoulFragmentThird: {
		DisplayName: Soul Fragment III
		Tooltip: Quest item - a cinder that still remembers the burn order, written by Machina herself. Hand it to her and she updates her memory on her own. Only one exists per world.
	}

	SoulFragmentFourth: {
		DisplayName: Soul Fragment IV
		Tooltip: Quest item - the last lock of the reset device, holding her true name. Hand it to her and she updates her memory on her own. Only one exists per world.
	}

